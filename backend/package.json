{
  "name": "backend",
  "version": "1.0.0",
  "description": "ResQPlate backend API - Express + TypeScript + Drizzle ORM/PostgreSQL, handling auth, listings, reservations, and pickup management.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "db:start": "docker compose -f ../docker-compose.yml up -d",
    "db:stop": "docker compose -f ../docker-compose.yml down",
    "db:force-stop": "docker compose -f ../docker-compose.yml down -v",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "node --import tsx --experimental-test-module-mocks --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:production": "node dist/db/seed.js",
    "search:configure": "tsx src/scripts/config-algolia.ts",
    "search:reindex": "tsx src/scripts/reindex-algolia.ts",
    "test:coverage": "node --import tsx --experimental-test-module-mocks --test --experimental-test-coverage --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "type": "module",
  "dependencies": {
    "algoliasearch": "^5.56.0",
    "better-auth": "^1.6.20",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "c8": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "private": true
}
