{
  "name": "final-project-group-12",
  "version": "1.0.0",
  "description": "ResQPlate - a food donation platform connecting restaurants and food businesses with people in need to reduce food waste.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "build": "npm run build -w packages/shared && npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:force-stop": "docker compose down -v",
    "db:migrate": "npm exec -w backend -- drizzle-kit migrate",
    "db:generate": "npm exec -w backend -- drizzle-kit generate",
    "db:studio": "npm exec -w backend -- drizzle-kit studio",
    "test": "npm run test -w backend",
    "test:coverage": "npm run test:coverage -w backend"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luvveer/resqplate.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Luvveer/resqplate/issues"
  },
  "homepage": "https://github.com/Luvveer/resqplate#readme",
  "private": true,
  "workspaces": [
    "backend",
    "packages/shared",
    "frontend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4"
  }
}
